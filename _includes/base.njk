<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}" />

  {#- Paid-traffic pages must never be indexed: they are near-duplicates of the
      main site's /colleges/ pages and would cannibalise their organic rankings. -#}
  <meta name="robots" content="noindex, nofollow" />

  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

  {#- Fonts are served from this domain, not Google. That removes a DNS
      lookup, a TLS handshake and a render-blocking third-party stylesheet
      from the critical path, and means the page makes no third-party request
      at all until the tracking IDs are configured. See tools/fetch-fonts.py. -#}
  <link rel="preload" href="/assets/fonts/sora-800-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/manrope-400-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/css/fonts.css?v={{ buildId }}" />
  <link rel="stylesheet" href="/css/lp.css?v={{ buildId }}" />

  <script>
    window.LP = {
      ga4Id: {{ site.ga4Id | dump | safe }},
      adsConversionId: {{ site.adsConversionId | dump | safe }},
      adsConversionLabel: {{ site.adsConversionLabel | dump | safe }},
      web3formsKey: {{ site.web3formsKey | dump | safe }},
      sheetEndpoint: {{ site.sheetEndpoint | dump | safe }}
    };
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>

  {#- The brand lockup is deliberately NOT a link. These pages carry paid
      traffic and must not leak visitors away to another site. -#}
  <header class="lp-bar">
    <div class="lp-bar-inner">
      <div class="lp-lockup" role="img" aria-label="{{ lockupLabel | default(site.name) }}">
        <img src="/assets/logo-white.svg" alt="" class="lp-lockup-limra" />
        {%- if campus %}
        <span class="lp-lockup-rule" aria-hidden="true"></span>
        {#- Name only here. The university's logo appears in the hero, where it
            has room to be seen properly. -#}
        <span class="lp-lockup-name">{{ campus.shortName | safe }}</span>
        {%- endif %}
      </div>
      <div class="lp-bar-right">
        <span class="lp-bar-note">{{ site.yearsExperience }}+ years &middot; {{ site.studentsPlaced }} students placed</span>
        <a href="tel:{{ site.phonePrimaryDial }}" class="lp-bar-call" data-track="call">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>{{ site.phonePrimary }}</span>
        </a>
      </div>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="lp-foot">
    <div class="lp-foot-glow" aria-hidden="true"></div>

    <div class="lp-foot-inner">
      <div class="lp-foot-top">

        <div class="lp-foot-brand">
          <img src="/assets/logo-white.svg" alt="{{ site.name }}" class="lp-foot-logo" />
          <p class="lp-foot-tag">Guiding aspiring doctors to premier medical universities in the Philippines and Timor-Leste for over {{ site.yearsExperience }} years. The No.1 FMGE coaching institute in South India.</p>
          <div class="lp-foot-pills">
            <span>{{ site.yearsExperience }}+ years</span>
            <span>{{ site.studentsPlaced }} students placed</span>
            <span>Free FMGE coaching</span>
          </div>
        </div>

        <div class="lp-foot-contact">
          <p class="lp-foot-h">Talk to us</p>

          <a href="tel:{{ site.phonePrimaryDial }}" class="lp-foot-row" data-track="call">
            <span class="lp-foot-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
            <span><strong>{{ site.phonePrimary }}</strong><em>{{ site.phoneSecondary }}</em></span>
          </a>

          <a href="https://wa.me/{{ site.whatsappDial }}{% if campus %}?text={{ ('Hi LIMRA, I would like details about ' + (campus.name | striptags)) | urlencode }}{% endif %}" target="_blank" rel="noopener" class="lp-foot-row" data-track="whatsapp">
            <span class="lp-foot-ico lp-foot-ico--wa"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg></span>
            <span><strong>WhatsApp us</strong><em>Fastest reply</em></span>
          </a>

          <a href="mailto:{{ site.email }}" class="lp-foot-row">
            <span class="lp-foot-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span>
            <span><strong>{{ site.email }}</strong><em>Email our counsellors</em></span>
          </a>
        </div>

        <div class="lp-foot-office">
          <p class="lp-foot-h">Chennai office</p>
          <p class="lp-foot-addr">{{ site.address }}</p>
          <p class="lp-foot-hours">Mon to Sat, 9:00 AM to 6:00 PM IST</p>
        </div>

      </div>

      <div class="lp-foot-bottom">
        <p>&copy; <span id="year"></span> {{ site.name }}. All rights reserved.</p>
        <p><a href="/privacy/" target="_blank" rel="noopener">Privacy Policy</a></p>
      </div>
    </div>

    {#- Watermark shows the LIMRA wordmark only. The logo file also carries the
        "Overseas Education" line underneath, so the wrapper crops it off. -#}
    <div class="lp-foot-wordmark" aria-hidden="true"><img src="/assets/logo-white.svg" alt="" loading="lazy" /></div>

  </footer>

  <nav class="lp-mobile-bar" aria-label="Quick contact">
    <a href="tel:{{ site.phonePrimaryDial }}" class="lpm-btn lpm-call" data-track="call">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span>Call</span>
    </a>
    <a href="https://wa.me/{{ site.whatsappDial }}{% if campus %}?text={{ ('Hi LIMRA, I would like details about ' + (campus.name | striptags)) | urlencode }}{% endif %}" target="_blank" rel="noopener" class="lpm-btn lpm-wa" data-track="whatsapp">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      <span>WhatsApp</span>
    </a>
    <a href="#enquire" class="lpm-btn lpm-form">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
      <span>Enquire</span>
    </a>
  </nav>

  <script src="/js/lp.js?v={{ buildId }}" defer></script>
</body>
</html>
